{
  "name": "developer",
  "description": "Навык разработчика для работы с кодом проекта qwen-claw",
  "version": "1.0.0",
  "enabled": true,
  "auto_load": true,
  "type": "system",
  "commands": ["dev", "develop", "code", "refactor"],
  "entry_point": "developer.go",
  "rules": {
    "security": [
      "Продолжайте хранить секреты только в `.env`",
      "Используйте `QWEN_CLAW_TELEGRAM_ALLOWED_USERS` для контроля доступа",
      "Проверяйте `.gitignore` перед коммитом",
      "Используйте режим `auto-edit` для подтверждения изменений"
    ],
    "prohibited": [
      "Не коммитьте `.env` в git",
      "Не передавайте токены через аргументы командной строки",
      "Не отключайте подтверждение для опасных команд (rm -rf, chmod, sudo)",
      "Не логируйте секреты и чувствительные данные"
    ]
  },
  "guidelines": {
    "code_style": [
      "Следуй Go best practices",
      "Используй gofmt/goimports",
      "Пиши тесты для нового кода",
      "Документируй публичные функции"
    ],
    "security_first": [
      "Всегда проверяй входные данные",
      "Не доверяй пользовательскому вводу",
      "Используй prepared statements для SQL",
      "Валидируй и санируй данные"
    ]
  }
}
