# Qwen-Claw Environment Variables
# Скопируйте этот файл в .env и заполните значениями

# Telegram Bot Token (от @BotFather)
QWEN_CLAW_TELEGRAM_TOKEN=""

# Telegram Allowed Users (список ID через запятую, опционально)
QWEN_CLAW_TELEGRAM_ALLOWED_USERS=""

# Qwen/DashScope API Key (если используется напрямую)
QWEN_CLAW_API_KEY=""

# Модель по умолчанию (опционально)
QWEN_CLAW_MODEL=""

# Режим подтверждения: plan, default, auto-edit, yolo
QWEN_CLAW_APPROVAL_MODE="auto-edit"

# Режим отладки: true/false
QWEN_CLAW_DEBUG="false"

# Порт сервера (опционально)
QWEN_CLAW_SERVER_PORT="18789"
