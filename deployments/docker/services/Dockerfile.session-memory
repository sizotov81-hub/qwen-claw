# Dockerfile для Session Memory Service
# Многоэтапная сборка для минимизации размера образа

# ============================================
# Этап 1: Сборка
# ============================================
FROM golang:1.25-alpine AS builder

WORKDIR /build

# Установка зависимостей
RUN apk add --no-cache git ca-certificates

# Копирование common модуля
COPY services/common /build/services/common
RUN cd /build/services/common && go mod download

# Копирование сервиса
COPY cmd/session-memory /build/cmd/session-memory
WORKDIR /build/cmd/session-memory

# Сборка
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /build/session-memory .

# ============================================
# Этап 2: Runtime
# ============================================
FROM alpine:3.19

WORKDIR /app

# Установка корневых сертификатов
RUN apk --no-cache add ca-certificates tzdata

# Создание non-root пользователя
RUN addgroup -g 1000 qwenclaw && \
    adduser -D -u 1000 -G qwenclaw qwenclaw

# Копирование бинарника
COPY --from=builder /build/session-memory /app/session-memory

# Настройка прав
RUN chown -R qwenclaw:qwenclaw /app
USER qwenclaw

# Переменные окружения
ENV SERVICE_NAME=session-memory
ENV GRPC_PORT=55051
ENV HTTP_PORT=58081
ENV METRICS_PORT=59091
ENV HOST=0.0.0.0
ENV LOG_LEVEL=info
ENV LOG_FORMAT=json

# Порты
EXPOSE 55051 58081 59091

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:58081/health || exit 1

# Запуск
ENTRYPOINT ["/app/session-memory"]
CMD ["--grpc-port=55051", "--http-port=58081", "--host=0.0.0.0"]
