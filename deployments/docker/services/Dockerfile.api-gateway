# Dockerfile для API Gateway Service
# Многоэтапная сборка для минимизации размера образа

# ============================================
# Этап 1: Сборка
# ============================================
FROM golang:1.25-alpine AS builder

WORKDIR /build

# Установка зависимостей
RUN apk add --no-cache git ca-certificates

# Копирование common модуля
COPY services/common /build/services/common
RUN cd /build/services/common && go mod download

# Копирование сервиса
COPY cmd/api-gateway /build/cmd/api-gateway
WORKDIR /build/cmd/api-gateway

# Сборка
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /build/api-gateway .

# ============================================
# Этап 2: Runtime
# ============================================
FROM alpine:3.19

WORKDIR /app

# Установка корневых сертификатов
RUN apk --no-cache add ca-certificates tzdata

# Создание non-root пользователя
RUN addgroup -g 1000 qwenclaw && \
    adduser -D -u 1000 -G qwenclaw qwenclaw

# Копирование бинарника
COPY --from=builder /build/api-gateway /app/api-gateway

# Настройка прав
RUN chown -R qwenclaw:qwenclaw /app
USER qwenclaw

# Переменные окружения
ENV SERVICE_NAME=api-gateway
ENV GRPC_PORT=55050
ENV HTTP_PORT=58080
ENV METRICS_PORT=59090
ENV HOST=0.0.0.0
ENV LOG_LEVEL=info
ENV LOG_FORMAT=json

# Порты
EXPOSE 55050 58080 59090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:58080/health || exit 1

# Запуск
ENTRYPOINT ["/app/api-gateway"]
CMD ["--grpc-port=55050", "--http-port=58080", "--host=0.0.0.0"]
