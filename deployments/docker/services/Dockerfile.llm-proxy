# Dockerfile для LLM Proxy Service
# Многоэтапная сборка для минимизации размера образа

# ============================================
# Этап 1: Сборка
# ============================================
FROM golang:1.25-alpine AS builder

WORKDIR /build

# Установка зависимостей
RUN apk add --no-cache git ca-certificates

# Копирование common модуля
COPY services/common /build/services/common
RUN cd /build/services/common && go mod download

# Копирование сервиса
COPY cmd/llm-proxy /build/cmd/llm-proxy
WORKDIR /build/cmd/llm-proxy

# Сборка
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /build/llm-proxy .

# ============================================
# Этап 2: Runtime
# ============================================
FROM alpine:3.19

WORKDIR /app

# Установка корневых сертификатов
RUN apk --no-cache add ca-certificates tzdata

# Создание non-root пользователя
RUN addgroup -g 1000 qwenclaw && \
    adduser -D -u 1000 -G qwenclaw qwenclaw

# Копирование бинарника
COPY --from=builder /build/llm-proxy /app/llm-proxy

# Настройка прав
RUN chown -R qwenclaw:qwenclaw /app
USER qwenclaw

# Переменные окружения
ENV SERVICE_NAME=llm-proxy
ENV GRPC_PORT=55053
ENV HTTP_PORT=58083
ENV METRICS_PORT=59093
ENV HOST=0.0.0.0
ENV LOG_LEVEL=info
ENV LOG_FORMAT=json

# Порты
EXPOSE 55053 58083 59093

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:58083/health || exit 1

# Запуск
ENTRYPOINT ["/app/llm-proxy"]
CMD ["--grpc-port=55053", "--http-port=58083", "--host=0.0.0.0"]
